# Copy these values into your local .env. Do not commit local secrets.
CUSTOMER_SUPPORT_MODE=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_REQUEST_TIMEOUT=120
# No cloud API key is needed for Ollama.

# Local service and persistent conversation state
HOST=127.0.0.1
PORT=8080
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=data/checkpoints.db
CUSTOMER_SUPPORT_DB_PATH=data/customer_support.db
