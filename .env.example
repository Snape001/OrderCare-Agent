# Customer support uses only real providers: llm, deepseek, qwen, ollama.
# llm uses DEFAULT_MODEL from the configured provider; fake is rejected.
CUSTOMER_SUPPORT_MODE=llm
# Optional explicit switch for local/cloud customer support: ollama or deepseek.
LLM_PROVIDER=

# API keys for different providers
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT=60
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

#Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Amazon Bedrock Knowledge Base ID
AWS_KB_ID="<knowledge-base-id>"

# Use a fake model for testing
USE_FAKE_MODEL=false

# Set a default model
DEFAULT_MODEL=

# If MODEL is set to "openai-compatible", set the following
# This is just a flexible solution. If you need multiple model options, you still need to add it to models.py
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web server configuration
HOST=0.0.0.0
PORT=8080

# Authentication secret, HTTP bearer token header is required if set.
# WARNING: If unset, all API endpoints are unauthenticated. Always set this in production.
AUTH_SECRET=
# Separate administrator credential. Empty disables database browsing.
DATABASE_ADMIN_SECRET=

# Langsmith configuration
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application mode. If the value is "dev", it will enable uvicorn reload
MODE=

# Database type.
# Customer-support business tools use SQLite by default; override only for an isolated database.
# CUSTOMER_SUPPORT_DB_PATH=data/customer_support.db
# If the value is "postgres", then it will require Postgresql related environment variables.
# If the value is "sqlite", then you can configure optional file path via SQLITE_DB_PATH
DATABASE_TYPE=

# Three-layer memory starts with the service. Run Redis locally (or use Compose).
# Set MEMORY_ENABLED=false only when intentionally running without Memory.
MEMORY_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_TTL_SECONDS=86400
# Router structured-Route cache (reuses the Memory Redis client; query-keyed, fail-open).
INTENT_CACHE_ENABLED=true
INTENT_CACHE_TTL_SECONDS=300
INTENT_CACHE_TIMEOUT_SECONDS=0.2
# MCP business read-result cache: order/refund 15 sec. Policy cache is at search_policy.
MCP_BUSINESS_CACHE_TTL_SECONDS=15
MCP_READ_CACHE_MAX_ENTRIES=512
# Per-call timeout and per-tool circuit breaker.
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_TICKET_TIMEOUT_SECONDS=20
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RESET_SECONDS=30
# Policy retrieval execution protection (inside search_policy, shared by direct and MCP calls).
POLICY_SEARCH_CACHE_TTL_SECONDS=600
POLICY_SEARCH_CACHE_MAX_ENTRIES=512
POLICY_SEARCH_TIMEOUT_SECONDS=30
POLICY_SEARCH_CIRCUIT_FAILURE_THRESHOLD=3
POLICY_SEARCH_CIRCUIT_RESET_SECONDS=30
POLICY_SEARCH_WORKER_LIMIT=2
MEMORY_SQLITE_PATH=data/customer_memories.db
CONTEXT_TOKEN_BUDGET=4096
CONTEXT_SYSTEM_BUDGET=1024
CONTEXT_HISTORY_BUDGET=1200
CONTEXT_MEMORY_BUDGET=640
CONTEXT_RAG_BUDGET=768
CONTEXT_TOOLS_BUDGET=720
CONTEXT_COMPACTION_THRESHOLD=0.8
CONTEXT_COMPACTION_SUMMARY_BUDGET=384
CONTEXT_COMPACTION_ENABLED=false
CONTEXT_HISTORY_SUMMARY_BUDGET=320
CONTEXT_LONG_TERM_BUDGET=120
CONTEXT_RECENT_TURNS=2
# Verified customers use a separate Chroma collection; compaction remains opt-in.
EPISODIC_MEMORY_ENABLED=true
EPISODIC_TOP_K=4
EPISODIC_SIMILARITY_THRESHOLD=0.55
EPISODIC_RECENCY_WEIGHT=0.15

# If DATABASE_TYPE=sqlite (Optional)
SQLITE_DB_PATH=

# If DATABASE_TYPE=postgres
# Docker Compose default values (will work with docker-compose setup)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# you will be able to identify AST connections in Postgres Connection Manager under this Application Name
# POSTGRES_APPLICATION_NAME = "agent-service-toolkit"
# set these values to customize the number of connections in the pool. Saver and store have independent connection pools
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL= 3

# OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=

# Add for running ollama
# OLLAMA_MODEL=llama3.2
# Note: set OLLAMA_BASE_URL if running service in docker and ollama on bare metal
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Add for running Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-4o": "gpt-4o-deployment", "gpt-4o-mini": "gpt-4o-mini-deployment"}

# Agent URL: used in Streamlit app - if not set, defaults to http://{HOST}:{PORT}
# AGENT_URL=http://localhost:8080
# Overall chat request deadline in seconds (applies to streaming and non-streaming calls)
# STREAMLIT_REQUEST_TIMEOUT_SECONDS=300

# LANGFUSE Configuration
#LANGFUSE_TRACING=true
#LANGFUSE_PUBLIC_KEY=pk-...
#LANGFUSE_SECRET_KEY=sk-lf-....
#LANGFUSE_HOST=http://localhost:3000

# GitHub MCP Agent Configuration
# GitHub Personal Access Token (required for GitHub MCP server)
# If not set, the GitHub MCP agent will have no tools
GITHUB_PAT=

# Voice Features (Optional)
# NOTE: Voice features are configured on the client (Streamlit app) side, not the server (API).
# Requires OPENAI_API_KEY to be set (see above).
# Set provider name to enable voice input/output. Leave empty to disable.
VOICE_STT_PROVIDER=        # Speech-to-text provider (only 'openai' supported currently)
VOICE_TTS_PROVIDER=        # Text-to-speech provider (only 'openai' supported currently)
