# Docker Compose local-development settings.
# These defaults are only for a local demo. Use strong secrets for any public deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=ecommerce_support
MYSQL_USER=support_app
MYSQL_PASSWORD=replace-with-a-strong-app-password
MYSQL_EXPOSED_PORT=3306
AUTH_SECRET=
# Optional, must differ from AUTH_SECRET. Empty disables database browsing.
DATABASE_ADMIN_SECRET=

# The service also reads the Qwen settings from the ignored .env file.
# Keep DASHSCOPE_API_KEY only in .env; never place the real key here.
