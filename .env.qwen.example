# Copy these names into .env. Never commit or share the real API key.
CUSTOMER_SUPPORT_MODE=auto
DASHSCOPE_API_KEY=replace-with-your-own-key
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus-2026-05-26

# Other demo services may continue to use the fake model.
USE_FAKE_MODEL=true
DEFAULT_MODEL=fake
